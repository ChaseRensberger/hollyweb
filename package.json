{
  "name": "@hollyweb/workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:bracket": "bun run --filter @hollyweb/bracket dev",
    "dev:hollydraft": "bun run --filter @hollyweb/hollydraft dev",
    "dev:auth": "bun run --filter @hollyweb/auth dev",
    "dev:core": "bun run --filter @hollyweb/core dev",
    "build": "bun run --sequential --workspaces build",
    "typecheck": "bun run --sequential --workspaces typecheck",
    "lint": "oxlint . --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "bun test",
    "db:migrate": "bun run --sequential --filter './apps/*' db:migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.3"
  }
}
