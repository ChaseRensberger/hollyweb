    "@tanstack/react-router": "1.169.2",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
